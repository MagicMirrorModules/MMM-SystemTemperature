{
  "name": "mmm-systemtemperature",
  "version": "2.1.1",
  "description": "A MagicMirror² module that displays your processor temperature.",
  "keywords": [
    "MagicMirror",
    "temperature",
    "system"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MagicMirrorModules/MMM-SystemTemperature"
  },
  "main": "MMM-SystemTemperature.js",
  "type": "commonjs",
  "scripts": {
    "demo": "cd ../../ && MM_CONFIG_FILE=modules/MMM-SystemTemperature/demo.config.js node --run start:dev",
    "lint": "eslint && prettier . --check",
    "lint:fix": "eslint --fix && prettier . --write",
    "release": "commit-and-tag-version --config ./changelog.config.js",
    "test": "node --run lint && node --run test:unit",
    "test:unit": "node --test tests/*.test.cjs"
  },
  "author": "Michael Teeuw",
  "contributors": [
    {
      "name": "Alvaro Naveda",
      "email": "alvaro@naveda.me",
      "url": "https://github.com/naveda89/"
    },
    {
      "name": "Kristjan ESPERANTO",
      "url": "https://github.com/KristjanEsperanto/"
    }
  ],
  "license": "MIT",
  "dependencies": {
    "systeminformation": "^5.33.15"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "commit-and-tag-version": "^13.2.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
